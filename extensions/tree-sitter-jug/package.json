        "incremental",
        "parsing",
        "tree-sitter",
        "jug",
        "juggernyaut"
    ],
    "devDependencies": {
        "tree-sitter-cli": "^0.24.0"
    },
    "scripts": {
        "generate:parser": "tree-sitter generate",
        "generate:vscode": "node scripts/generate-vscode.js",
