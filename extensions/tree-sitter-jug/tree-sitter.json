{
  "grammars": [
    {
      "name": "jug",
      "camelcase": "Jug",
      "scope": "source.jug",
      "path": ".",
      "file-types": [
        "jug"
      ],
      "injection-regex": "^(jug|juggernyaut)$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Juggernyaut grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-jug"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
