{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Juggernyaut",
  "scopeName": "source.juggernyaut",
  "patterns": [
    {
      "include": "#root-order"
    }
  ],
  "repository": {
    "root-order": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#literals"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#operators"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.juggernyaut",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#comment-highlights"
            }
          ]
        },
        {
          "name": "comment.line.double-slash.juggernyaut",
          "begin": "//",
          "end": "\\n",
          "patterns": [
            {
              "include": "#comment-highlights"
            }
          ]
        }
      ]
    },
    "comment-highlights": {
      "patterns": [
        {
          "name": "comment.highlight.warning.juggernyaut",
          "match": "(?<![^\\s])(@!.+)(?=\\n)",
          "captures": {
            "1": {
              "name": "invalid.warning.juggernyaut"
            }
          }
        },
        {
          "name": "comment.highlight.title.juggernyaut",
          "match": "(?<![^\\s])(@[^\\s]+)",
          "captures": {
            "1": {
              "name": "markup.inserted.juggernyaut"
            }
          }
        },
        {
          "name": "comment.highlight.escape.juggernyaut",
          "begin": "{(?=[^\\n]*\\}[^\\n]*)",
          "end": "}",
          "captures": {
            "0": {
              "name": "markup.italic.juggernyaut"
            }
          },
          "patterns": [
            {
              "include": "#root-order"
            },
            {
              "name": "markup.italic.juggernyaut",
              "match": "[^\\n]+?"
            }
          ]
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "include": "#strings"
        },
        {
          "include": "#chars"
        },
        {
          "include": "#booleans"
        },
        {
          "include": "#numbers"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.juggernyaut",
          "begin": "\"",
          "end": "(((?<!\\\\)\")|((?<!\\\\)\\r?\\n))",
          "patterns": [
            {
              "include": "#escapeSequences"
            }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.juggernyaut",
          "begin": "'",
          "end": "(((?<!\\\\)')|((?<!\\\\)\\r?\\n))",
          "patterns": [
            {
              "include": "#escapeSequences"
            }
          ]
        }
      ]
    },
    "escapeSequences": {
      "patterns": [
        {
          "name": "constant.character.escape.juggernyaut",
          "match": "\\\\([nrt0\"'bfv\\\\]|\\r?\\n)"
        },
        {
          "name": "invalid.illegal.juggernyaut",
          "match": "\\\\([^nrt0\"'bfv\\\\\\r\\n])"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.juggernyaut",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.juggernyaut",
          "match": "\\b(0[bB][01]+|0[oO][0-7]+|0[xX][0-9a-fA-F]+|([1-9]|[12][0-9]|3[0-6])d[0-9a-zA-Z]+|[0-9]*\\.[0-9]+([eE][+-]?[0-9]+)?|[0-9]+)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.import.juggernyaut",
          "match": "\\b(import|export|bind)\\b"
        },
        {
          "name": "storage.type.juggernyaut",
          "match": "\\b(let|func|type|abstract)\\b"
        },
        {
          "name": "storage.modifier.juggernyaut",
          "match": "\\b(const|ref)\\b"
        },
        {
          "name": "keyword.control.logic.juggernyaut",
          "match": "\\b(from|as|return|if|else|while|for|do|end|skip|in|switch|case|fall)\\b"
        },
        {
          "name": "keyword.control.silly.juggernyaut",
          "match": "\\b(cat|kitty|meow|bad_code)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.juggernyaut",
          "match": "(\\*\\*=|\\\\\\\\=|%%=|<<=|>>=|@@=|##=|~~=|->|\\+\\+|--|\\*\\*|\\\\\\\\|%%|\\.\\.|<<|>>|@@|##|~~|\\+=|-=|\\*=|/=|\\\\=|%=|&=|\\|=|\\^=|@=|#=|~=|==|!=|<=|>=|&&|\\|\\||\\^\\^|;|:|\\.|,|\\+|-|!|~|\\*|/|\\\\|%|&|\\||\\^|@|#|=|<|>)"
        }
      ]
    }
  }
}
